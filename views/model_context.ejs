      <div style="font-size:12px; color:var(--muted);">0 = Repaid, 1 = Defaulted</div>
    </div>

    <div class="metric-summary-card">
      <div style="font-size:11px; text-transform:uppercase; font-weight:700; color:var(--muted); margin-bottom:6px;">Dataset Size</div>
