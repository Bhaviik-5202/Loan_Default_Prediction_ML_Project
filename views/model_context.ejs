        </thead>
        <tbody>
          <tr><td><code>Age</code></td><td>Integer</td><td>Numerical Continuous</td><td>StandardScaler</td><td>Borrower age in years (18 to 69)</td></tr>
          <tr><td><code>Income</code></td><td>Integer</td><td>Numerical Continuous</td><td>StandardScaler</td><td>Annual verified earnings ($15,000 to $149,999)</td></tr>
          <tr><td><code>LoanAmount</code></td><td>Integer</td><td>Numerical Continuous</td><td>StandardScaler</td><td>Requested loan principal ($5,000 to $249,999)</td></tr>
          <tr><td><code>CreditScore</code></td><td>Integer</td><td>Numerical Discrete</td><td>StandardScaler</td><td>Bureau credit risk score (300 to 849)</td></tr>
          <tr><td><code>MonthsEmployed</code></td><td>Integer</td><td>Numerical Continuous</td><td>StandardScaler</td><td>Current employer tenure in months (0 to 119)</td></tr>
          <tr><td><code>NumCreditLines</code></td><td>Integer</td><td>Numerical Discrete</td><td>StandardScaler</td><td>Number of open active revolving accounts (1 to 4)</td></tr>
          <tr><td><code>InterestRate</code></td><td>Float</td><td>Numerical Continuous</td><td>StandardScaler</td><td>Annualized interest percentage (2.0% to 25.0%)</td></tr>
          <tr><td><code>LoanTerm</code></td><td>Integer</td><td>Numerical Discrete</td><td>StandardScaler</td><td>Amortization horizon in months (12 to 60)</td></tr>
          <tr><td><code>DTIRatio</code></td><td>Float</td><td>Numerical Ratio</td><td>StandardScaler</td><td>Monthly debt divided by gross income (0.10 to 0.90)</td></tr>
          <tr><td><code>Education</code></td><td>Object</td><td>Categorical Nominal</td><td>One-Hot (drop_first)</td><td>High School, Bachelor's, Master's, PhD</td></tr>
          <tr><td><code>EmploymentType</code></td><td>Object</td><td>Categorical Nominal</td><td>One-Hot (drop_first)</td><td>Full-time, Part-time, Self-employed, Unemployed</td></tr>
          <tr><td><code>MaritalStatus</code></td><td>Object</td><td>Categorical Nominal</td><td>One-Hot (drop_first)</td><td>Single, Married, Divorced</td></tr>
          <tr><td><code>HasMortgage</code></td><td>Object</td><td>Categorical Binary</td><td>One-Hot (Yes/No)</td><td>Whether applicant maintains real estate mortgage</td></tr>
          <tr><td><code>HasDependents</code></td><td>Object</td><td>Categorical Binary</td><td>One-Hot (Yes/No)</td><td>Whether borrower has financial dependents</td></tr>
          <tr><td><code>LoanPurpose</code></td><td>Object</td><td>Categorical Nominal</td><td>One-Hot (drop_first)</td><td>Auto, Business, Education, Home, Other</td></tr>
          <tr><td><code>HasCoSigner</code></td><td>Object</td><td>Categorical Binary</td><td>One-Hot (Yes/No)</td><td>Whether secondary guarantor co-signs debt</td></tr>
        </tbody>
      </table>
    </div>
  </div>

</div>

