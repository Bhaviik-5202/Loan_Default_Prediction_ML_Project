<%- include('partials/header', { title: 'Model Comparison Matrix — LoanLens', crumb: '<b>Workspace</b> / Model Comparison', currentPath: '/model/comparison' }) %>

<div style="max-width: 1080px; margin: 0 auto; padding-bottom: 60px;">

  <div class="page-head" style="margin-bottom: 24px;">
    <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px;">
      <div>
        <h1 style="font-size:26px; font-weight:700; margin:0 0 6px 0;">Model Benchmark Comparison Matrix</h1>
        <p style="color:var(--text-muted); margin:0; font-size:14px;">
          Empirical evaluation of 4 classification algorithms on 51,070 test loans with 5-Fold Stratified Cross-Validation.
        </p>
      </div>
      <div style="display:flex; gap:10px;">
        <span class="badge low" style="font-size:12px; padding:6px 14px;">
          Primary Validation: ROC-AUC & F1-Score
        </span>
      </div>
    </div>
  </div>

  <!-- Best Model Selection Rationale Banner -->
  <% const selected = models.find(m => m.isSelected) || models[0]; %>
  <div class="card" style="padding:24px; border-left:4px solid var(--brand); margin-bottom:28px; background:color-mix(in srgb, var(--brand) 4%, var(--panel));">
    <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px; margin-bottom:8px;">
      <div>
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
          <span class="badge high" style="font-size:11px; background:rgba(16,185,129,0.15); color:#10b981;">SELECTED BEST MODEL &middot; PIPELINE VERIFIED</span>
          <span style="font-size:13px; color:var(--muted);">Trained on 204,277 records &middot; Tested on 51,070 records</span>
        </div>
        <h2 style="font-size:20px; font-weight:700; margin:0; color:var(--text);">
          <%= selected.name %> (<%= selected.family %>)
        </h2>
      </div>
      <div style="text-align:right;">
        <div style="font-size:24px; font-weight:700; color:var(--brand); line-height:1;">
          <%= selected.metrics.roc_auc.toFixed(4) %> <span style="font-size:14px; color:var(--muted); font-weight:500;">Test ROC-AUC</span>
        </div>
        <div style="font-size:12px; color:var(--muted); margin-top:2px;">5-Fold CV: <%= selected.metrics.cv_roc_auc_mean.toFixed(4) %> &plusmn; <%= selected.metrics.cv_roc_auc_std.toFixed(4) %></div>
      </div>
    </div>
    <p style="font-size:13px; color:var(--muted); line-height:1.6; margin:0;">
      <strong>Pipeline Selection Rationale:</strong> In credit risk modeling with an 11.61% default rate, raw accuracy is uninformative. <%= selected.name %> achieved the highest discriminative ranking power across the risk spectrum (Test ROC-AUC: <%= selected.metrics.roc_auc.toFixed(4) %>, 5-Fold CV AUC: <%= selected.metrics.cv_roc_auc_mean.toFixed(4) %>) and superior default recall (<%= (selected.metrics.recall * 100).toFixed(1) %>%), delivering reliable borrower credit tier separation and capturing at-risk loans while avoiding excessive false alarms.
    </p>
  </div>

  <!-- Model Comparison Table -->
  <div class="card" style="padding:24px; margin-bottom:28px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap; gap:12px;">
      <h2 style="font-size:18px; font-weight:700; margin:0;">Algorithm Performance Matrix</h2>
      <span style="font-size:12px; color:var(--muted);">Holdout: 51,070 test records &middot; Stratified Split</span>
    </div>

    <div class="table-wrap">
      <table class="dtable">
        <thead>
          <tr>
            <th>Model Name</th>
            <th>Algorithm Type</th>
            <th>Accuracy</th>
            <th>Precision</th>
            <th>Recall</th>
            <th>F1-Score</th>
            <th>ROC-AUC</th>
            <th>5-Fold CV AUC</th>
            <th>Training Time</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% models.forEach(function(m) { %>
          <tr style="<%= m.isSelected ? 'background:rgba(49,135,125,0.06); font-weight:600;' : '' %>">
            <td>
              <div style="display:flex; flex-direction:column;">
                <span style="font-weight:700;"><%= m.name %></span>
                <span style="font-size:11px; color:var(--muted);"><%= m.library %></span>
              </div>
            </td>
            <td><%= m.algorithm %></td>
            <td><%= (m.metrics.accuracy * 100).toFixed(2) %>%</td>
            <td><%= (m.metrics.precision * 100).toFixed(2) %>%</td>
            <td><%= (m.metrics.recall * 100).toFixed(2) %>%</td>
            <td><%= m.metrics.f1_score.toFixed(3) %></td>
            <td><strong style="color:var(--brand);"><%= m.metrics.roc_auc.toFixed(3) %></strong></td>
            <td><%= m.metrics.cv_roc_auc_mean.toFixed(3) %> &plusmn; <%= m.metrics.cv_roc_auc_std.toFixed(3) %></td>
            <td><%= m.metrics.training_time || 'N/A' %></td>
            <td>
              <span class="badge <%= m.isSelected ? 'low' : m.status.includes('Scratch') ? 'med' : 'low' %>" style="font-size:11px;">
                <%= m.status %>
              </span>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Scientific Audit: Scratch vs. Sklearn Logistic Regression -->
  <div class="card" style="padding:24px; margin-bottom:28px; border-left:4px solid #0284c7; background:color-mix(in srgb, #0284c7 3%, var(--panel));">
    <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:12px; margin-bottom:12px;">
      <div>
        <span class="badge" style="font-size:11px; background:rgba(2,132,199,0.15); color:#0284c7; font-weight:700;">VALIDATION AUDIT &middot; FIRST-PRINCIPLES SOP VERIFICATION</span>
        <h3 style="font-size:17px; font-weight:700; margin:4px 0 0; color:var(--text);">
          Scratch vs. Scikit-Learn Logistic Regression: Apples-to-Apples Scientific Audit
        </h3>
      </div>
      <span style="font-size:12px; font-weight:600; color:var(--muted);">Pearson Weight Correlation: <strong style="color:#0284c7;">r = 0.9946</strong></span>
    </div>
    
    <p style="font-size:13px; color:var(--muted); line-height:1.6; margin:0 0 16px;">
      <strong>Audit Question:</strong> <em>Why does Scratch Logistic Regression show 88.52% accuracy and 0.7530 ROC-AUC, while Tuned Production Sklearn shows 67.64% accuracy and 0.7532 ROC-AUC?</em> 
      This is <strong>not</strong> an algorithmic flaw or performance divergence. The two models were evaluated under different operational objectives (standard unweighted MLE vs. cost-sensitive balanced loss).
    </p>

    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:16px; margin-bottom:16px;">
      <div style="background:var(--surface); padding:16px; border-radius:8px; border:1px solid var(--border);">
        <div style="font-size:12px; font-weight:700; color:var(--text); text-transform:uppercase; margin-bottom:6px;">Condition A: True Apples-to-Apples (Unweighted, Threshold = 0.50)</div>
        <div style="font-size:12px; color:var(--muted); margin-bottom:10px;">Same training loss (standard MLE) &amp; same decision threshold:</div>
        <table style="width:100%; font-size:12px; border-collapse:collapse;">
          <tr style="border-bottom:1px solid var(--border);"><td style="padding:4px 0; color:var(--muted);">Scratch NumPy LR:</td><td style="font-weight:600; text-align:right;">Acc: 88.52% &middot; Rec: 3.44% &middot; ROC-AUC: <strong>0.7530</strong></td></tr>
          <tr style="border-bottom:1px solid var(--border);"><td style="padding:4px 0; color:var(--muted);">Sklearn Unweighted:</td><td style="font-weight:600; text-align:right;">Acc: 88.52% &middot; Rec: 3.30% &middot; ROC-AUC: <strong>0.7531</strong></td></tr>
          <tr><td style="padding:4px 0; color:#10b981; font-weight:600;">Convergence Delta:</td><td style="font-weight:700; color:#10b981; text-align:right;">&Delta;Acc = 0.00% &middot; &Delta;AUC = 0.0001</td></tr>
        </table>
      </div>

      <div style="background:var(--surface); padding:16px; border-radius:8px; border:1px solid var(--border);">
        <div style="font-size:12px; font-weight:700; color:var(--text); text-transform:uppercase; margin-bottom:6px;">Condition B: Cost-Adjusted (Threshold = 0.1161 / Balanced)</div>
        <div style="font-size:12px; color:var(--muted); margin-bottom:10px;">Compensating for 11.61% default base rate:</div>
        <table style="width:100%; font-size:12px; border-collapse:collapse;">
          <tr style="border-bottom:1px solid var(--border);"><td style="padding:4px 0; color:var(--muted);">Scratch @ th=0.116:</td><td style="font-weight:600; text-align:right;">Acc: 67.45% &middot; Rec: 70.29% &middot; ROC-AUC: <strong>0.7530</strong></td></tr>
          <tr style="border-bottom:1px solid var(--border);"><td style="padding:4px 0; color:var(--muted);">Sklearn Balanced @ 0.5:</td><td style="font-weight:600; text-align:right;">Acc: 67.64% &middot; Rec: 69.95% &middot; ROC-AUC: <strong>0.7532</strong></td></tr>
          <tr><td style="padding:4px 0; color:#10b981; font-weight:600;">Cost Match Delta:</td><td style="font-weight:700; color:#10b981; text-align:right;">&Delta;Acc = 0.19% &middot; &Delta;Rec = 0.34%</td></tr>
        </table>
      </div>
    </div>

    <div style="font-size:12px; color:var(--muted); line-height:1.6;">
      <strong>Key Takeaways for Viva / Project Review:</strong><br>
      &bull; <strong>Why ROC-AUC is identical:</strong> ROC-AUC measures ranking discrimination across all thresholds. Both models converged to the exact same linear decision boundary in 24D space ($r = 0.9946$).<br>
      &bull; <strong>Why accuracy differs in the table:</strong> Unweighted Scratch optimizes overall accuracy by classifying almost everything as non-default (88.5% accuracy, but misses 96.6% of defaults). Sklearn with <code>class_weight='balanced'</code> penalizes false negatives ~7.61x, shifting the intercept to catch 70.0% of defaults at the expected cost of nominal accuracy.
    </div>
  </div>

  <!-- ROC Curves & Performance Visualizations -->
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(460px, 1fr)); gap:20px; margin-bottom:28px;">
    <!-- ROC Curves Chart -->
    <div class="card" style="padding:24px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
        <h3 style="font-size:16px; font-weight:700; margin:0;">Receiver Operating Characteristic (ROC)</h3>
        <span style="font-size:12px; color:var(--muted);">True vs. False Positive Rates</span>
      </div>
      <div style="height:300px; position:relative;">
        <canvas id="rocChart"></canvas>
      </div>
    </div>

    <!-- F1 vs ROC-AUC Tradeoff -->
    <div class="card" style="padding:24px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
        <h3 style="font-size:16px; font-weight:700; margin:0;">Model Discrimination Benchmark</h3>
        <span style="font-size:12px; color:var(--muted);">Imbalance Sensitivity</span>
      </div>
      <div style="height:300px; position:relative;">
        <canvas id="benchmarkBarChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Reusable Model Cards Grid -->
  <h2 style="font-size:18px; font-weight:700; margin:0 0 16px;">Model Inspection Cards</h2>
  <div class="model-grid">
    <% models.forEach(function(model) { %>
      <%- include('components/model_card', { model: model }) %>
    <% }); %>
  </div>

</div>

<%- include('partials/footer', {
  extraScripts: `
<script>
document.addEventListener('DOMContentLoaded', function() {
  const rocCurves = ${JSON.stringify(rocCurves)};
  const models = ${JSON.stringify(models)};

  // 1. ROC Curves Chart
  const rocDatasets = [];
  for (let modelName in rocCurves) {
    const data = rocCurves[modelName];
    const pts = data.fpr.map((fpr, i) => ({ x: fpr, y: data.tpr[i] }));
    rocDatasets.push({
      label: \`\${modelName} (AUC = \${data.auc})\`,
      data: pts,
      borderColor: data.color || '#31877d',
      borderWidth: 2.5,
      fill: false,
      pointRadius: 0,
      tension: 0.2
    });
  }

  // Diagonal chance line
  rocDatasets.push({
    label: 'Random Baseline (AUC = 0.50)',
    data: [{x:0, y:0}, {x:1, y:1}],
    borderColor: '#94a3b8',
    borderDash: [5, 5],
    borderWidth: 1.5,
    pointRadius: 0
  });

  new Chart(document.getElementById('rocChart'), {
    type: 'scatter',
    data: { datasets: rocDatasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        x: { title: { display: true, text: 'False Positive Rate (1 - Specificity)' }, min: 0, max: 1 },
        y: { title: { display: true, text: 'True Positive Rate (Sensitivity / Recall)' }, min: 0, max: 1 }
      },
      plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } }
    }
  });

  // 2. Discrimination Benchmark Bar Chart
  const modelNames = models.map(m => m.name);
  const aucScores = models.map(m => m.metrics.roc_auc);
  const f1Scores = models.map(m => m.metrics.f1_score);

  new Chart(document.getElementById('benchmarkBarChart'), {
    type: 'bar',
    data: {
      labels: modelNames,
      datasets: [
        {
          label: 'ROC-AUC',
          data: aucScores,
          backgroundColor: '#31877d',
          borderRadius: 4
        },
        {
          label: 'F1-Score',
          data: f1Scores,
          backgroundColor: '#06b6d4',
          borderRadius: 4
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: { min: 0, max: 1.0, title: { display: true, text: 'Validation Score' } }
      },
      plugins: { legend: { position: 'bottom' } }
    }
  });
});
</script>
  `
}) %>
