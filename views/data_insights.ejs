<%- include('partials/header', { title: 'Dataset Insights & EDA — LoanLens', crumb: '<b>Workspace</b> / Data Insights', currentPath: '/data/insights' }) %>

<div style="max-width: 1080px; margin: 0 auto; padding-bottom: 60px;">

  <div class="page-head" style="margin-bottom: 24px;">
    <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px;">
      <div>
        <h1 style="font-size:26px; font-weight:700; margin:0 0 6px 0;">Exploratory Data Analysis & Dataset Insights</h1>
        <p style="color:var(--text-muted); margin:0; font-size:14px;">
          Empirical distribution analysis for 255,347 curated loan records across 16 borrower features.
        </p>
      </div>
      <span class="badge low" style="font-size:12px; padding:6px 14px;">
        100% Data Completeness Verified
      </span>
    </div>
  </div>

  <!-- Primary Stat Cards -->
  <div class="metrics-row-4">
    <div class="metric-summary-card">
      <div style="font-size:11px; text-transform:uppercase; font-weight:700; color:var(--muted); margin-bottom:6px;">Total Records</div>
      <div class="metric-val"><%= insights.total_records.toLocaleString() %></div>
      <div class="metric-lbl">Curated Applications</div>
      <div class="metric-sub">Kaggle Banking Default Corpus</div>
    </div>

    <div class="metric-summary-card">
      <div style="font-size:11px; text-transform:uppercase; font-weight:700; color:var(--muted); margin-bottom:6px;">Default Rate</div>
      <div class="metric-val" style="color:var(--high);"><%= insights.default_percentage %>%</div>
      <div class="metric-lbl"><%= insights.default_count.toLocaleString() %> Defaulters</div>
      <div class="metric-sub">88.4% Non-Default baseline</div>
    </div>

    <div class="metric-summary-card">
      <div style="font-size:11px; text-transform:uppercase; font-weight:700; color:var(--muted); margin-bottom:6px;">Clean Input Signals</div>
      <div class="metric-val"><%= insights.clean_features %> Features</div>
      <div class="metric-lbl">9 Numerical &middot; 7 Categorical</div>
      <div class="metric-sub">Expands to 24 encoded inputs</div>
    </div>

    <div class="metric-summary-card">
      <div style="font-size:11px; text-transform:uppercase; font-weight:700; color:var(--muted); margin-bottom:6px;">Data Integrity</div>
      <div class="metric-val" style="color:var(--low);">0 Missing</div>
      <div class="metric-lbl">0 Duplicates</div>
      <div class="metric-sub">Verified clean distribution</div>
    </div>
  </div>

  <!-- Charts Row 1: Target Distribution & Categorical Distribution -->
  <div style="display:grid; grid-template-columns: 1fr 1.6fr; gap:20px; margin-bottom:28px;">
    <!-- Target Distribution Donut -->
    <div class="card" style="padding:24px;">
      <h3 style="font-size:16px; font-weight:700; margin:0 0 4px;">Target Class Distribution</h3>
      <p style="font-size:12px; color:var(--muted); margin:0 0 16px;">Imbalance ratio in ground truth labels ($y \in \{0, 1\}$).</p>
      <div style="height:220px; position:relative;">
        <canvas id="targetDistributionChart"></canvas>
      </div>
      <div style="display:flex; justify-content:center; gap:20px; margin-top:14px; font-size:12px;">
        <div style="display:flex; align-items:center; gap:6px;">
          <span style="width:10px; height:10px; border-radius:3px; background:#31877d;"></span>
          <span>Non-Default: <strong>88.4%</strong></span>
        </div>
        <div style="display:flex; align-items:center; gap:6px;">
          <span style="width:10px; height:10px; border-radius:3px; background:#ef4444;"></span>
          <span>Default: <strong>11.6%</strong></span>
        </div>
      </div>
    </div>

    <!-- Loan Purpose Distribution -->
    <div class="card" style="padding:24px;">
      <h3 style="font-size:16px; font-weight:700; margin:0 0 4px;">Loan Purpose Distribution</h3>
      <p style="font-size:12px; color:var(--muted); margin:0 0 16px;">Breakdown across requested loan categories.</p>
      <div style="height:240px; position:relative;">
        <canvas id="loanPurposeChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Charts Row 2: Employment & Education Breakdown -->
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(460px, 1fr)); gap:20px; margin-bottom:28px;">
    <!-- Employment Type Distribution -->
    <div class="card" style="padding:24px;">
      <h3 style="font-size:16px; font-weight:700; margin:0 0 4px;">Employment Classification</h3>
      <p style="font-size:12px; color:var(--muted); margin:0 0 16px;">Distribution of work status across applicants.</p>
      <div style="height:220px; position:relative;">
        <canvas id="employmentChart"></canvas>
      </div>
    </div>

    <!-- Education Level Breakdown -->
    <div class="card" style="padding:24px;">
      <h3 style="font-size:16px; font-weight:700; margin:0 0 4px;">Education Credentials</h3>
      <p style="font-size:12px; color:var(--muted); margin:0 0 16px;">Completed educational attainment levels.</p>
      <div style="height:220px; position:relative;">
        <canvas id="educationChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Numerical Features Summary Table -->
  <div class="card" style="padding:24px; margin-bottom:28px;">
    <h2 style="font-size:18px; font-weight:700; margin:0 0 6px;">Continuous & Discrete Numerical Feature Summary</h2>
    <p style="font-size:13px; color:var(--muted); margin:0 0 18px;">
      Parametric bounds and central tendency statistics from exploratory data profiling:
    </p>

    <div class="table-wrap">
      <table class="dtable">
        <thead>
          <tr>
            <th>Feature Name</th>
            <th>Data Type</th>
            <th>Min Value</th>
            <th>Max Value</th>
            <th>Mean Value</th>
            <th>Median Value</th>
            <th>Preprocessing Scaling</th>
          </tr>
        </thead>
        <tbody>
          <% Object.entries(insights.numerical_summaries).forEach(function([feat, s]) { %>
          <tr>
            <td><code><%= feat %></code></td>
            <td><%= feat === 'DTIRatio' || feat === 'InterestRate' ? 'Float' : 'Integer' %></td>
            <td><%= s.min.toLocaleString() %></td>
            <td><%= s.max.toLocaleString() %></td>
            <td><%= typeof s.mean === 'number' ? s.mean.toFixed(2) : s.mean %></td>
            <td><%= typeof s.median === 'number' ? s.median.toFixed(2) : s.median %></td>
            <td><span class="badge low" style="font-size:11px;">StandardScaler</span></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Risk Correlations & EDA Findings -->
  <div class="card" style="padding:24px;">
    <h2 style="font-size:18px; font-weight:700; margin:0 0 14px;">Key EDA Insights & Lending Risk Findings</h2>
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap:16px;">
      <div style="padding:16px; background:var(--surface); border-radius:10px; border:1px solid var(--border);">
        <div style="font-size:14px; font-weight:700; color:var(--text); margin-bottom:6px;">1. Interest Rate Burden Sensitivity</div>
        <p style="font-size:12px; color:var(--muted); line-height:1.6; margin:0;">
          Interest rate exhibits the highest positive linear correlation (+0.458 log-odds) with loan default. Applicants charged higher APRs face heavier payment stress.
        </p>
      </div>

      <div style="padding:16px; background:var(--surface); border-radius:10px; border:1px solid var(--border);">
        <div style="font-size:14px; font-weight:700; color:var(--text); margin-bottom:6px;">2. Age & Tenure Protective Buffer</div>
        <p style="font-size:12px; color:var(--muted); line-height:1.6; margin:0;">
          Both borrower age and months employed exhibit significant negative correlations (-0.585 and -0.337) with default, indicating established tenure strongly stabilizes repayment.
        </p>
      </div>

      <div style="padding:16px; background:var(--surface); border-radius:10px; border:1px solid var(--border);">
        <div style="font-size:14px; font-weight:700; color:var(--text); margin-bottom:6px;">3. Co-Signer Risk Mitigation</div>
        <p style="font-size:12px; color:var(--muted); line-height:1.6; margin:0;">
          Applications backed by a secondary creditworthy co-signer experience substantially lower delinquency rates across all income brackets.
        </p>
      </div>
    </div>
  </div>

</div>

<%- include('partials/footer', {
  extraScripts: `
<script>
document.addEventListener('DOMContentLoaded', function() {
  const insights = ${JSON.stringify(insights)};

  // 1. Target Distribution Donut Chart
  new Chart(document.getElementById('targetDistributionChart'), {
    type: 'doughnut',
    data: {
      labels: ['Non-Default (0)', 'Default (1)'],
      datasets: [{
        data: [insights.non_default_count, insights.default_count],
        backgroundColor: ['#31877d', '#ef4444'],
        borderWidth: 0,
        cutout: '72%'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } }
    }
  });

  // 2. Loan Purpose Chart
  const purpLabels = Object.keys(insights.categorical_distributions.LoanPurpose);
  const purpCounts = Object.values(insights.categorical_distributions.LoanPurpose);

  new Chart(document.getElementById('loanPurposeChart'), {
    type: 'bar',
    data: {
      labels: purpLabels,
      datasets: [{
        label: 'Applicants',
        data: purpCounts,
        backgroundColor: '#4f46e5',
        borderRadius: 4
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        y: { beginAtZero: true, title: { display: true, text: 'Applicant Count' } }
      }
    }
  });

  // 3. Employment Type Chart
  const empLabels = Object.keys(insights.categorical_distributions.EmploymentType);
  const empCounts = Object.values(insights.categorical_distributions.EmploymentType);

  new Chart(document.getElementById('employmentChart'), {
    type: 'bar',
    data: {
      labels: empLabels,
      datasets: [{
        label: 'Applicants',
        data: empCounts,
        backgroundColor: '#06b6d4',
        borderRadius: 4
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } }
    }
  });

  // 4. Education Chart
  const eduLabels = Object.keys(insights.categorical_distributions.Education);
  const eduCounts = Object.values(insights.categorical_distributions.Education);

  new Chart(document.getElementById('educationChart'), {
    type: 'bar',
    data: {
      labels: eduLabels,
      datasets: [{
        label: 'Applicants',
        data: eduCounts,
        backgroundColor: '#10b981',
        borderRadius: 4
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } }
    }
  });
});
</script>
  `
}) %>
