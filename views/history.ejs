<%- include('partials/header', { title: 'Prediction History — LoanLens', crumb: '<b>Prediction History</b>', currentPath: '/predictions' }) %>

<div class="page-title-row">
  <div>
    <h1>Prediction History</h1>
    <p><%= apps.length %> scored applications.</p>
  </div>
</div>

<div class="chart-card">
  <div class="toolbar">
    <input type="text" id="searchInput" placeholder="Search by applicant or ID...">
    <select id="riskFilter">
      <option value="">All risk levels</option>
      <option value="Low">Low</option>
      <option value="Medium">Medium</option>
      <option value="High">High</option>
    </select>
    <select id="sortSelect">
      <option value="date-desc">Newest first</option>
      <option value="date-asc">Oldest first</option>
      <option value="prob-desc">Highest risk first</option>
      <option value="prob-asc">Lowest risk first</option>
      <option value="credit-desc">Credit score (high–low)</option>
    </select>
  </div>

  <% if (apps && apps.length > 0) { %>
  <div class="table-wrap">
    <table class="dtable">
      <thead><tr><th>ID</th><th>Applicant</th><th>Credit Score</th><th>Loan Amount</th><th>DTI</th><th>Risk Level</th><th>Probability</th><th>Prediction</th><th>Date</th></tr></thead>
      <tbody id="tableBody"></tbody>
    </table>
  </div>

  <div class="pagination" id="pagination"></div>
  <% } else { %>
  <div class="empty-state">
    No predictions yet. Completed risk assessments will appear here.
  </div>
  <% } %>
</div>

<%- include('partials/footer', {
  extraScripts: apps && apps.length > 0 ? `
    <script>window.APPLICATIONS = ${JSON.stringify(apps)};</script>
    <script src="/static/js/history.js"></script>
  ` : ''
}) %>
