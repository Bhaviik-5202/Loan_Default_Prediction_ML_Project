<%- include('partials/header', { title: 'New Assessment — LoanLens', crumb: '<b>Workspace</b> / New Assessment', currentPath: '/assess' }) %>

<div style="max-width: 960px; margin: 0 auto; padding-bottom: 60px;">

  <div class="page-head" style="margin-bottom: 24px;">
    <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px;">
      <div>
        <h1 style="font-size:26px; font-weight:700; margin:0 0 6px 0;">New Borrower Risk Assessment</h1>
        <p style="color:var(--text-muted); margin:0; font-size:14px;">
          Submit borrower attributes to evaluate default probability, credit risk signals, and policy recommendations.
        </p>
      </div>

      <!-- Quick preset test buttons for reviewers -->
      <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
        <span style="font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase;">Load Sample:</span>
        <button type="button" class="btn-ghost" data-preset="prime" style="padding:4px 10px; font-size:12px; min-height:30px;">
          Prime (Low Risk)
        </button>
        <button type="button" class="btn-ghost" data-preset="moderate" style="padding:4px 10px; font-size:12px; min-height:30px;">
          Moderate Risk
        </button>
        <button type="button" class="btn-ghost" data-preset="subprime" style="padding:4px 10px; font-size:12px; min-height:30px;">
          Subprime (High Risk)
        </button>
      </div>
    </div>
  </div>

  <!-- Main Assessment Form Card -->
  <div class="card" id="formCard" style="padding:32px; box-shadow:var(--shadow-1);">
    <form id="assessmentForm" onsubmit="return false;">

      <!-- SECTION 1: Borrower Information -->
      <div style="margin-bottom:32px;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
          <span style="width:24px; height:24px; border-radius:50%; background:rgba(49,135,125,0.15); color:var(--brand); font-size:12px; font-weight:700; display:flex; align-items:center; justify-content:center;">1</span>
          <h2 style="font-size:17px; font-weight:700; margin:0;">Borrower Information</h2>
        </div>
        <p style="font-size:13px; color:var(--muted); margin:0 0 18px 32px;">Personal and demographic background attributes.</p>

        <div class="field-grid" style="padding-left:32px;">
          <div class="field">
            <label for="Name">Borrower Name (Optional)</label>
            <span class="hint">Identifies the application in the portfolio ledger.</span>
            <input type="text" id="Name" name="Name" placeholder="e.g. John Doe" value="Eleanor Vance" maxlength="120">
          </div>

          <div class="field">
            <label for="Age">Age (Years) *</label>
            <span class="hint">Borrower age at application (18–100).</span>
            <input type="number" id="Age" name="Age" min="18" max="100" value="42" required>
            <span class="err-msg">Valid age between 18 and 100 is required.</span>
          </div>

          <div class="field">
            <label for="Education">Education Level *</label>
            <span class="hint">Highest completed credential.</span>
            <select id="Education" name="Education" required>
              <option value="High School">High School</option>
              <option value="Bachelor's" selected>Bachelor's</option>
              <option value="Master's">Master's</option>
              <option value="PhD">PhD</option>
            </select>
          </div>

          <div class="field">
            <label for="MaritalStatus">Marital Status *</label>
            <span class="hint">Current legal marital filing.</span>
            <select id="MaritalStatus" name="MaritalStatus" required>
              <option value="Single">Single</option>
              <option value="Married" selected>Married</option>
              <option value="Divorced">Divorced</option>
            </select>
          </div>

          <div class="field">
            <label>Financially Dependent Persons *</label>
            <span class="hint">Children or adults relying on applicant income.</span>
            <div class="toggle-row">
              <input type="radio" id="dep-no" name="HasDependents" value="No" checked><label for="dep-no">No</label>
              <input type="radio" id="dep-yes" name="HasDependents" value="Yes"><label for="dep-yes">Yes</label>
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION 2: Employment / Income -->
      <div style="margin-bottom:32px; padding-top:24px; border-top:1px solid var(--border);">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
          <span style="width:24px; height:24px; border-radius:50%; background:rgba(49,135,125,0.15); color:var(--brand); font-size:12px; font-weight:700; display:flex; align-items:center; justify-content:center;">2</span>
          <h2 style="font-size:17px; font-weight:700; margin:0;">Employment / Income</h2>
        </div>
        <p style="font-size:13px; color:var(--muted); margin:0 0 18px 32px;">Work tenure and stability indicators.</p>

        <div class="field-grid" style="padding-left:32px;">
          <div class="field">
            <label for="EmploymentType">Employment Classification *</label>
            <span class="hint">Current employment status.</span>
            <select id="EmploymentType" name="EmploymentType" required>
              <option value="Full-time" selected>Full-time</option>
              <option value="Part-time">Part-time</option>
              <option value="Self-employed">Self-employed</option>
              <option value="Unemployed">Unemployed</option>
            </select>
          </div>

          <div class="field">
            <label for="MonthsEmployed">Tenure at Employer (Months) *</label>
            <span class="hint">Continuous months in current role (0–600).</span>
            <input type="number" id="MonthsEmployed" name="MonthsEmployed" min="0" max="600" value="64" required>
            <span class="err-msg">Tenure in months is required.</span>
          </div>

          <div class="field">
            <label for="Income">Annual Verified Income ($) *</label>
            <span class="hint">Gross annual earnings before tax.</span>
            <input type="number" id="Income" name="Income" min="0" max="10000000" step="500" value="115000" required>
            <span class="err-msg">Annual income is required.</span>
          </div>
        </div>
      </div>

      <!-- SECTION 3: Credit & Financial Information -->
      <div style="margin-bottom:32px; padding-top:24px; border-top:1px solid var(--border);">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
          <span style="width:24px; height:24px; border-radius:50%; background:rgba(49,135,125,0.15); color:var(--brand); font-size:12px; font-weight:700; display:flex; align-items:center; justify-content:center;">3</span>
          <h2 style="font-size:17px; font-weight:700; margin:0;">Credit & Financial Information</h2>
        </div>
        <p style="font-size:13px; color:var(--muted); margin:0 0 18px 32px;">Bureau scores and ongoing solvency commitments.</p>

        <div class="field-grid" style="padding-left:32px;">
          <div class="field">
            <label for="CreditScore">Credit Score (FICO-Equivalent) *</label>
            <span class="hint">Valid bureau score from 300 to 850.</span>
            <input type="number" id="CreditScore" name="CreditScore" min="300" max="850" value="780" required>
            <span class="err-msg">Credit score between 300 and 850 is required.</span>
          </div>

          <div class="field">
            <label for="NumCreditLines">Open Credit Accounts *</label>
            <span class="hint">Total active credit lines on bureau file (0–100).</span>
            <input type="number" id="NumCreditLines" name="NumCreditLines" min="0" max="100" value="3" required>
            <span class="err-msg">Credit lines count is required.</span>
          </div>

          <div class="field">
            <label for="DTIRatio">Debt-to-Income (DTI) Ratio *</label>
            <span class="hint">Total monthly debt obligations divided by monthly gross income (0.00–1.00).</span>
            <input type="number" id="DTIRatio" name="DTIRatio" min="0" max="1" step="0.01" value="0.22" required>
            <span class="err-msg">DTI Ratio between 0 and 1 is required.</span>
          </div>
        </div>
      </div>

      <!-- SECTION 4: Loan Information -->
      <div style="margin-bottom:32px; padding-top:24px; border-top:1px solid var(--border);">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
          <span style="width:24px; height:24px; border-radius:50%; background:rgba(49,135,125,0.15); color:var(--brand); font-size:12px; font-weight:700; display:flex; align-items:center; justify-content:center;">4</span>
          <h2 style="font-size:17px; font-weight:700; margin:0;">Loan Information</h2>
        </div>
        <p style="font-size:13px; color:var(--muted); margin:0 0 18px 32px;">Requested principal amount, term length, and risk mitigations.</p>

        <div class="field-grid" style="padding-left:32px;">
          <div class="field">
            <label for="LoanAmount">Requested Loan Principal ($) *</label>
            <span class="hint">Total principal requested ($500–$10,000,000).</span>
            <input type="number" id="LoanAmount" name="LoanAmount" min="500" max="10000000" step="500" value="25000" required>
            <span class="err-msg">Valid loan amount is required.</span>
          </div>

          <div class="field">
            <label for="InterestRate">Interest Rate (APR %) *</label>
            <span class="hint">Annual percentage rate (0.00%–100.00%).</span>
            <input type="number" id="InterestRate" name="InterestRate" min="0" max="100" step="0.1" value="6.8" required>
            <span class="err-msg">Interest rate is required.</span>
          </div>

          <div class="field">
            <label for="LoanTerm">Loan Term (Months) *</label>
            <span class="hint">Repayment duration schedule.</span>
            <select id="LoanTerm" name="LoanTerm" required>
              <option value="12">12 Months (1 Year)</option>
              <option value="24">24 Months (2 Years)</option>
              <option value="36" selected>36 Months (3 Years)</option>
              <option value="48">48 Months (4 Years)</option>
              <option value="60">60 Months (5 Years)</option>
            </select>
          </div>

          <div class="field">
            <label for="LoanPurpose">Loan Purpose Category *</label>
            <span class="hint">Intended disbursement objective.</span>
            <select id="LoanPurpose" name="LoanPurpose" required>
              <option value="Auto">Auto Purchase</option>
              <option value="Business">Business Expansion</option>
              <option value="Education">Education Tuition</option>
              <option value="Home" selected>Home Improvement / Mortgaged</option>
              <option value="Other">Other Personal</option>
            </select>
          </div>

          <div class="field">
            <label>Existing Real Estate Mortgage? *</label>
            <span class="hint">Active property lien on record.</span>
            <div class="toggle-row">
              <input type="radio" id="mort-no" name="HasMortgage" value="No"><label for="mort-no">No</label>
              <input type="radio" id="mort-yes" name="HasMortgage" value="Yes" checked><label for="mort-yes">Yes</label>
            </div>
          </div>

          <div class="field">
            <label>Creditworthy Co-Signer Attached? *</label>
            <span class="hint">Secondary guarantor backing debt obligations.</span>
            <div class="toggle-row">
              <input type="radio" id="co-no" name="HasCoSigner" value="No" checked><label for="co-no">No</label>
              <input type="radio" id="co-yes" name="HasCoSigner" value="Yes"><label for="co-yes">Yes</label>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Footer -->
      <div style="display:flex; justify-content:space-between; align-items:center; padding-top:24px; border-top:1px solid var(--border); flex-wrap:wrap; gap:16px;">
        <button type="button" class="btn-ghost" id="resetBtn">
          Reset
        </button>
        <button type="button" class="btn-primary" id="runAssessmentBtn" style="padding:12px 28px; font-size:15px; display:inline-flex; align-items:center; gap:8px;">
          <span>Run Assessment</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </div>

    </form>
  </div>

  <!-- Loading State Container -->
  <div id="loadingView" style="display:none;" class="card"></div>

  <!-- Prediction Result Screen Container -->
  <div id="resultView" style="display:none;"></div>

</div>

<%- include('partials/footer', {
  extraScripts: '<script src="/static/js/predict.js"></script>'
}) %>
