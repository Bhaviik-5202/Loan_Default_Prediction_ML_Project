<%# Reusable RiskResultCard component %>
<div class="card" style="padding:28px; margin-top:20px;">
  <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px; margin-bottom:24px; padding-bottom:20px; border-bottom:1px solid var(--border);">
    <div>
      <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
        <span class="badge <%= result.risk_level === 'Low' ? 'low' : result.risk_level === 'Medium' ? 'med' : 'high' %>" style="font-size:13px; padding:6px 16px;">
          Risk Level: <%= result.risk_level.toUpperCase() %>
        </span>
        <span style="font-size:12px; color:var(--color-text-tertiary);">
          Model: <b><%= result.model_used %></b>
        </span>
      </div>
      <h2 style="font-size:24px; font-weight:700; margin:0 0 4px; color:var(--color-text-primary);">
        <%= result.prediction %>
      </h2>
      <p style="font-size:13px; color:var(--color-text-tertiary); margin:0;">
        Classification Label: <strong><%= result.label %></strong> (Default Probability: <strong><%= result.probability %>%</strong> &middot; Confidence: <strong><%= (result.confidence * 100).toFixed(0) %>%</strong>)
      </p>
    </div>

    <div style="display:flex; gap:20px; align-items:center;">
      <div style="text-align:right;">
        <div style="font-size:32px; font-weight:700; color:var(--color-text-primary); line-height:1;">
          <%= result.risk_score %><span style="font-size:16px; color:var(--color-text-tertiary);"> / 100</span>
        </div>
        <div style="font-size:11px; font-weight:600; text-transform:uppercase; color:var(--color-text-tertiary); margin-top:4px;">
          Institutional Risk Score
        </div>
      </div>
    </div>
  </div>

  <!-- Why this prediction? Section -->
  <div style="margin-bottom:28px;">
    <h3 style="font-size:16px; font-weight:700; color:var(--color-text-primary); margin:0 0 6px;">
      Why this prediction?
    </h3>
    <p style="font-size:13px; color:var(--color-text-tertiary); margin:0 0 16px;">
      Key borrower signals evaluated against institutional underwriting benchmarks:
    </p>

    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:14px;">
      <% result.factors.forEach(function(factor) { %>
      <div style="padding:14px 16px; background:var(--surface); border:1px solid var(--border); border-radius:10px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
          <span style="font-size:13px; font-weight:600; color:var(--color-text-primary);">
            <%= factor.label %>
          </span>
          <span style="font-size:12px; font-weight:600; color:<%= factor.direction === 'up' ? 'var(--color-status-danger)' : 'var(--color-status-success)' %>;">
            <%= factor.direction === 'up' ? '+ Risk Driver' : '- Protective' %>
          </span>
        </div>
        <div style="height:6px; background:var(--border); border-radius:999px; overflow:hidden; margin-bottom:8px;">
          <div style="height:100%; border-radius:999px; width:<%= factor.impact %>%; background:<%= factor.direction === 'up' ? 'var(--color-status-danger)' : 'var(--color-status-success)' %>;"></div>
        </div>
        <div style="display:flex; justify-content:space-between; font-size:11px; color:var(--color-text-tertiary);">
          <span>Value: <b><%= factor.value %></b></span>
          <span>Benchmark: <b><%= factor.benchmark %></b></span>
        </div>
      </div>
      <% }); %>
    </div>
  </div>

  <!-- Recommendations -->
  <div style="background:color-mix(in srgb, var(--color-surface-raised) 8%, var(--panel)); border:1px solid color-mix(in srgb, var(--color-surface-raised) 25%, transparent); border-radius:12px; padding:20px; margin-bottom:24px;">
    <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-surface-raised)" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      <span style="font-size:14px; font-weight:700; color:var(--color-surface-raised);">
        <%= result.recommendation.action %>
      </span>
    </div>
    <ul style="margin:0; padding-left:20px; font-size:13px; color:var(--color-text-primary); line-height:1.7;">
      <% result.recommendation.points.forEach(function(pt) { %>
      <li><%= pt %></li>
      <% }); %>
    </ul>
  </div>

  <div style="display:flex; gap:12px; justify-content:flex-end;">
    <button type="button" class="btn-primary" onclick="resetAssessmentForm()">
      Run Another Assessment
    </button>
  </div>
</div>
