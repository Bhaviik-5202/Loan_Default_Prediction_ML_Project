<%- include('partials/header', { title: 'Feature Importance Analysis — LoanLens', crumb: '<b>ML Analysis</b> / Feature Importance (Week 5–6)', currentPath: '/feature/importance' }) %>

<% const importance = (metrics && metrics.feature_importances) ? metrics.feature_importances : []; %>

<div class="page-head" style="margin-bottom: 24px;">
  <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px;">
    <div>
      <h1 style="font-size:24px; font-weight:700; margin:0 0 6px 0;">Feature Importance & Attribution Analysis</h1>
      <p style="color:var(--text-muted); margin:0; font-size:14px;">
        Quantitative ranking of risk drivers extracted from HistGradientBoosting and Logistic Regression models.
      </p>
    </div>
    <div>
      <span class="badge" style="background:rgba(99,102,241,0.15); color:#818cf8; border:1px solid rgba(99,102,241,0.3); font-weight:600; padding:6px 14px; border-radius:20px;">
        Tree Attribution + Linear Coefficients
      </span>
    </div>
  </div>
</div>

<!-- Summary Metrics Cards -->
<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:16px; margin-bottom:24px;">
  <div class="card" style="padding:18px; border-radius:12px; background:var(--card-bg); border:1px solid var(--border);">
    <div style="font-size:12px; text-transform:uppercase; color:var(--text-muted); font-weight:600;">#1 Risk Driver</div>
    <div style="font-size:22px; font-weight:700; color:#ef4444; margin:6px 0 2px 0;">
      <%= importance.length > 0 ? importance[0].feature : 'Unavailable' %>
    </div>
    <div style="font-size:12px; color:var(--text-muted);">
      <%= importance.length > 0 ? (importance[0].importance * 100).toFixed(2) + '%' : 'Metrics artifact unavailable' %>
    </div>
  </div>
  <div class="card" style="padding:18px; border-radius:12px; background:var(--card-bg); border:1px solid var(--border);">
    <div style="font-size:12px; text-transform:uppercase; color:var(--text-muted); font-weight:600;">#2 Solvency Driver</div>
    <div style="font-size:22px; font-weight:700; color:#3b82f6; margin:6px 0 2px 0;">
      <%= importance.length > 1 ? importance[1].feature : 'Unavailable' %>
    </div>
    <div style="font-size:12px; color:var(--text-muted);">
      <%= importance.length > 1 ? (importance[1].importance * 100).toFixed(2) + '%' : 'Metrics artifact unavailable' %>
    </div>
  </div>
  <div class="card" style="padding:18px; border-radius:12px; background:var(--card-bg); border:1px solid var(--border);">
    <div style="font-size:12px; text-transform:uppercase; color:var(--text-muted); font-weight:600;">#3 Leverage Driver</div>
    <div style="font-size:22px; font-weight:700; color:#f59e0b; margin:6px 0 2px 0;">
      <%= importance.length > 2 ? importance[2].feature : 'Unavailable' %>
    </div>
    <div style="font-size:12px; color:var(--text-muted);">
      <%= importance.length > 2 ? (importance[2].importance * 100).toFixed(2) + '%' : 'Metrics artifact unavailable' %>
    </div>
  </div>
  <div class="card" style="padding:18px; border-radius:12px; background:var(--card-bg); border:1px solid var(--border);">
    <div style="font-size:12px; text-transform:uppercase; color:var(--text-muted); font-weight:600;">Total Encoded Features</div>
    <div style="font-size:22px; font-weight:700; color:#10b981; margin:6px 0 2px 0;">24 Features</div>
    <div style="font-size:12px; color:var(--text-muted);">Standardized & One-Hot Encoded</div>
  </div>
</div>

<!-- Feature Importance Chart -->
<div style="display:grid; grid-template-columns: 2fr 1fr; gap:20px; margin-bottom:24px;">
  <div class="card" style="padding:22px; border-radius:12px; background:var(--card-bg); border:1px solid var(--border);">
    <h2 style="font-size:18px; font-weight:600; margin:0 0 16px 0;">HistGradientBoosting Feature Importance (Gini / Permutation)</h2>
    <div style="height:340px;">
      <canvas id="featureImportanceChart"></canvas>
    </div>
  </div>

  <div class="card" style="padding:22px; border-radius:12px; background:var(--card-bg); border:1px solid var(--border);">
    <h2 style="font-size:18px; font-weight:600; margin:0 0 14px 0;">Risk Impact Direction</h2>
    <p style="font-size:13px; color:var(--text-muted); margin-bottom:14px;">
      How variations in key borrower metrics push the default probability up or down:
    </p>
    <div style="display:flex; flex-direction:column; gap:10px; font-size:13px;">
      <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 12px; background:rgba(239,68,68,0.08); border-radius:8px; border-left:3px solid #ef4444;">
        <span><strong>Interest Rate</strong> &uarr;</span>
        <span style="color:#ef4444; font-weight:600;">+ Risk (Positive Coef)</span>
      </div>
      <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 12px; background:rgba(239,68,68,0.08); border-radius:8px; border-left:3px solid #ef4444;">
        <span><strong>DTI Ratio</strong> &uarr;</span>
        <span style="color:#ef4444; font-weight:600;">+ Risk (Positive Coef)</span>
      </div>
      <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 12px; background:rgba(239,68,68,0.08); border-radius:8px; border-left:3px solid #ef4444;">
        <span><strong>Loan Amount</strong> &uarr;</span>
        <span style="color:#ef4444; font-weight:600;">+ Risk (Positive Coef)</span>
      </div>
      <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 12px; background:rgba(16,185,129,0.08); border-radius:8px; border-left:3px solid #10b981;">
        <span><strong>Income</strong> &uarr;</span>
        <span style="color:#10b981; font-weight:600;">&minus; Risk (Protective)</span>
      </div>
      <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 12px; background:rgba(16,185,129,0.08); border-radius:8px; border-left:3px solid #10b981;">
        <span><strong>Credit Score</strong> &uarr;</span>
        <span style="color:#10b981; font-weight:600;">&minus; Risk (Protective)</span>
      </div>
      <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 12px; background:rgba(16,185,129,0.08); border-radius:8px; border-left:3px solid #10b981;">
        <span><strong>Has Co-Signer</strong> = Yes</span>
        <span style="color:#10b981; font-weight:600;">&minus; Risk (Protective)</span>
      </div>
    </div>
  </div>
</div>

<!-- Detailed Table -->
<div class="card" style="padding:22px; border-radius:12px; background:var(--card-bg); border:1px solid var(--border);">
  <h2 style="font-size:18px; font-weight:600; margin:0 0 16px 0;">All 24 Features Ranked by Model Weight</h2>
  <div style="overflow-x:auto;">
    <table style="width:100%; border-collapse:collapse; font-size:13px; text-align:left;">
      <thead>
        <tr style="border-bottom:1px solid var(--border); color:var(--text-muted); background:var(--surface);">
          <th style="padding:10px 14px;">Rank</th>
          <th style="padding:10px 14px;">Feature Name</th>
          <th style="padding:10px 14px;">Relative Importance</th>
          <th style="padding:10px 14px;">Weight Bar</th>
          <th style="padding:10px 14px;">Domain Category</th>
        </tr>
      </thead>
      <tbody>
        <% if (importance && importance.length > 0) { %>
          <% importance.forEach((item, index) => { %>
          <tr style="border-bottom:1px solid var(--border);">
            <td style="padding:10px 14px; font-weight:600;">#<%= index + 1 %></td>
            <td style="padding:10px 14px; font-weight:500;"><code><%= item.feature %></code></td>
            <td style="padding:10px 14px; font-weight:600; color:#818cf8;"><%= (item.importance * 100).toFixed(2) %>%</td>
            <td style="padding:10px 14px; width:30%;">
              <div style="background:var(--surface); height:8px; border-radius:4px; overflow:hidden;">
                <div style="background:linear-gradient(90deg, #6366f1, #a855f7); width:<%= (item.importance / importance[0].importance * 100).toFixed(1) %>%; height:100%;"></div>
              </div>
            </td>
            <td style="padding:10px 14px; color:var(--text-muted);">
              <% if (item.feature.includes('Income') || item.feature.includes('Loan') || item.feature.includes('DTI') || item.feature.includes('Interest')) { %>
                Financial & Debt
              <% } else if (item.feature.includes('Credit')) { %>
                Credit History
              <% } else if (item.feature.includes('Age') || item.feature.includes('Education') || item.feature.includes('Marital')) { %>
                Demographic
              <% } else if (item.feature.includes('Employment') || item.feature.includes('Months')) { %>
                Employment
              <% } else { %>
                Structural
              <% } %>
            </td>
          </tr>
          <% }); %>
        <% } else { %>
          <tr style="border-bottom:1px solid var(--border);"><td colspan="5" style="padding:14px;">Metrics are unavailable. Re-run model training to restore this report.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer', {
  extraScripts: `
<script>
document.addEventListener("DOMContentLoaded", function() {
  const ctx = document.getElementById('featureImportanceChart');
  if (!ctx) return;
  
  const importance = ${JSON.stringify(importance)};
  const labels = importance.slice(0, 12).map((item) => item.feature);
  const values = importance.slice(0, 12).map((item) => item.importance);

  if (!values.length) return;
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: labels,
      datasets: [{
        label: 'Feature Weight Score',
        data: values,
        backgroundColor: [
          '#ef4444', '#3b82f6', '#f59e0b', '#ec4899', '#8b5cf6',
          '#10b981', '#06b6d4', '#6366f1', '#14b8a6', '#84cc16',
          '#a855f7', '#64748b'
        ],
        borderRadius: 6
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      indexAxis: 'y',
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: function(ctx) { return 'Weight: ' + (ctx.raw * 100).toFixed(1) + '%'; }
          }
        }
      },
      scales: {
        x: {
          grid: { color: 'rgba(255,255,255,0.06)' },
          ticks: { color: '#94a3b8', callback: function(v) { return (v*100) + '%'; } }
        },
        y: {
          grid: { display: false },
          ticks: { color: '#cbd5e1' }
        }
      }
    }
  });
});
</script>
  `
}) %>
